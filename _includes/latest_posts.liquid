<div class="latest-posts">
  {% assign latest_posts_size = site.posts | size %}
  {% if latest_posts_size > 0 %}
    {% assign latest_posts = site.posts %}
    {% if page.latest_posts.limit %}
      {% assign latest_posts_limit = page.latest_posts.limit %}
    {% else %}
      {% assign latest_posts_limit = latest_posts_size %}
    {% endif %}

    {% for item in latest_posts limit: latest_posts_limit %}
      <article class="latest-post">
        <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %-d, %Y' }}</time>
        <div class="latest-post__content">
          {% if item.redirect == blank %}
            <h3>
              <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
            </h3>
          {% elsif item.redirect contains '://' %}
            <h3>
              <a href="{{ item.redirect }}" target="_blank">{{ item.title }}</a>
            </h3>
          {% else %}
            <h3>
              <a href="{{ item.redirect | relative_url }}">{{ item.title }}</a>
            </h3>
          {% endif %}

          {% if item.description %}
            <p>{{ item.description }}</p>
          {% endif %}

          {% if item.tags.size > 0 %}
            <ul class="latest-post__tags" aria-label="Tags for {{ item.title }}">
              {% for tag in item.tags limit: 3 %}
                <li>{{ tag }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
        <a
          class="latest-post__arrow"
          href="{% if item.redirect == blank %}{{ item.url | relative_url }}{% elsif item.redirect contains '://' %}{{ item.redirect }}{% else %}{{ item.redirect | relative_url }}{% endif %}"
          aria-label="Read {{ item.title }}"
          >&rarr;</a
        >
      </article>
    {% endfor %}
  {% else %}
    <p>No posts so far...</p>
  {% endif %}
</div>
