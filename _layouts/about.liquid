---
layout: default
---
<div class="home-page">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__copy">
      <p class="home-kicker">Chuck Blake · founder & fractional CTO · Brooklyn</p>
      <h1 id="home-title">I build AI systems that ship.</h1>
      <p class="home-deck">
        I work with early-stage startups on technical architecture, AI integration, and the practical systems that keep product teams moving.
      </p>

      <div class="home-actions" aria-label="Primary actions">
        <a
          class="home-button home-button--primary"
          href="https://calendly.com/chuck-blake/30min"
          target="_blank"
          rel="noopener"
          >Book a call</a
        >
        <a class="home-button" href="{{ '/blog/' | relative_url }}">Read writing</a>
        <a class="home-button" href="{{ '/projects/' | relative_url }}">View projects</a>
      </div>

      <p class="home-topics">
        Deep on:
        <a href="{{ '/blog/' | relative_url }}">AI agents</a>
        <span>/</span>
        <a href="{{ '/fractional-cto/' | relative_url }}">startup engineering</a>
        <span>/</span>
        <a href="{{ '/music/' | relative_url }}">electronic music</a>
      </p>
    </div>

    {% if page.profile.image %}
      <aside class="home-hero__portrait" aria-label="About Chuck">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid
          loading="eager"
          path=profile_image_path
          class="home-portrait-img"
          sizes="(min-width: 992px) 360px, 90vw"
          alt="Chuck Blake"
          cache_bust=true
        %}
        <dl class="home-ledger">
          <div>
            <dt>Currently</dt>
            <dd>Arwen and Glance</dd>
          </div>
          <div>
            <dt>Recently</dt>
            <dd>CTO and co-founder at LEA</dd>
          </div>
          <div>
            <dt>Writing</dt>
            <dd>In General and field notes on AI work</dd>
          </div>
        </dl>
      </aside>
    {% endif %}
  </section>

  <section class="home-section home-intro" aria-labelledby="home-intro-title">
    <div class="home-section__label">What I do</div>
    <div class="home-section__body">
      <h2 id="home-intro-title">I help founders turn technical uncertainty into shipped product.</h2>
      <div class="home-prose">
        {{ content }}
      </div>
    </div>
  </section>

  <section class="home-section home-building" aria-labelledby="home-building-title">
    <div class="home-section__label">Building now</div>
    <div class="home-section__body">
      <div class="home-section__heading-row">
        <h2 id="home-building-title">Current work</h2>
        <a href="{{ '/projects/' | relative_url }}">All projects</a>
      </div>
      <div class="home-card-grid">
        <article class="home-card">
          <p class="home-card__eyebrow">AI product</p>
          <h3><a href="https://arwensaves.com/">Arwen</a></h3>
          <p>AI-assisted medical-bill review that helps patients find errors, understand paperwork, and pay with confidence.</p>
        </article>
        <article class="home-card">
          <p class="home-card__eyebrow">Production</p>
          <h3><a href="https://glnc.io">Glance</a></h3>
          <p>Expectation monitoring for automated work: scheduled checks, receipts, alerts, and remediation work items.</p>
        </article>
        <article class="home-card">
          <p class="home-card__eyebrow">Music tools</p>
          <h3><a href="https://getmusic.fm">GetMusic</a></h3>
          <p>Free Bandcamp-code discovery and artist promotion, with AI-operated growth loops behind the scenes.</p>
        </article>
        <article class="home-card">
          <p class="home-card__eyebrow">Music tools</p>
          <h3><a href="https://indiecrates.com">IndieCrates</a></h3>
          <p>Shareable Bandcamp crates for scenes, releases, and independent-music communities.</p>
        </article>
      </div>
    </div>
  </section>

  {% if page.latest_posts and page.latest_posts.enabled %}
    <section class="home-section home-writing" aria-labelledby="home-writing-title">
      <div class="home-section__label">Recent writing</div>
      <div class="home-section__body">
        <div class="home-section__heading-row">
          <h2 id="home-writing-title">Notes from the workbench</h2>
          <a href="{{ '/blog/' | relative_url }}">Full archive</a>
        </div>
        {% include latest_posts.liquid %}
      </div>
    </section>
  {% endif %}
</div>
